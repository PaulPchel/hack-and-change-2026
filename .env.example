# Скопируйте в .env и заполните. Настоящие ключи в git не кладём.
DATA_DIR=data
DB_PATH=storage/app.db
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b
EMB_MODEL=baai/bge-m3
TOP_K=8
MAX_TOKENS=1024
TEMPERATURE=0.1
MAX_WORKERS=4
# 1 = всегда использовать заглушку вместо настоящего консультанта
USE_STUB=0
